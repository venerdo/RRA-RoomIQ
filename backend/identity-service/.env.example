# RRA RoomIQ Identity Service
DB_URL=jdbc:postgresql://localhost:5432/roomiq_identity
DB_USERNAME=postgres
DB_PASSWORD=change-me

SERVER_PORT=8081

# Generate a random secret with at least 32 bytes for HS256. Never commit the real value.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P7D
