# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/RRA_RoomIQ
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Application
SERVER_PORT=8081

# Security
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P7D

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rra-roomiq/rooms
ROOM_PHOTO_MAX_FILE_SIZE_BYTES=5242880
ROOM_PHOTO_MAX_COUNT=10
ROOM_PHOTO_MAX_FILE_SIZE=5MB
ROOM_PHOTO_MAX_REQUEST_SIZE=6MB

# Email
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
