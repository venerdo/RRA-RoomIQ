# Shared backend development environment placeholders
# Copy this file to .env and fill in local values.

DB_URL=jdbc:postgresql://localhost:5432/RRA_RoomIQ
DB_USERNAME=postgres
DB_PASSWORD=change-me
SERVER_PORT=8081
ORGANIZATION_SERVICE_PORT=8082
ROOM_SERVICE_PORT=8083
SCHEDULING_SERVICE_PORT=8084
SCHEDULING_SERVICE_PORT=8084
SCHEDULING_SERVICE_PORT=8084

# Generate a random secret with at least 32 bytes for HS256. Never commit the real value.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P7D

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rra-roomiq/rooms
ROOM_PHOTO_MAX_FILE_SIZE_BYTES=5242880
ROOM_PHOTO_MAX_COUNT=10
ROOM_PHOTO_MAX_FILE_SIZE=5MB
ROOM_PHOTO_MAX_REQUEST_SIZE=6MB

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

FRONTEND_URL=http://localhost:3000
GATEWAY_URL=http://localhost:8080

# Service URLs
IDENTITY_SERVICE_URL=http://localhost:8081
ORGANIZATION_SERVICE_URL=http://localhost:8082
ROOM_SERVICE_URL=http://localhost:8083
SCHEDULING_SERVICE_URL=http://localhost:8084
BOOKING_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086
AUDIT_SERVICE_URL=http://localhost:8087
ANALYTICS_SERVICE_URL=http://localhost:8088
